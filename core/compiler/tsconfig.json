{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023", "dom"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // `src/__fixtures__/**` is no longer excluded, so the 101 authored `.ink.tsx` fixtures need the
    // authoring JSX settings — the same pair `ui/components/tsconfig.json` uses.
    "jsx": "react-jsx",
    "jsxImportSource": "@inkline/core"
  }
}
